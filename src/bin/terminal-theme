#!/bin/bash

set -euo pipefail

THEME_FILE="${HOME}/.config/ghostty/theme.conf"
LIGHT_THEME="Flexoki Light"

current_theme() {
  if [[ -f "$THEME_FILE" ]] && [[ "$(<"$THEME_FILE")" == *"theme = ${LIGHT_THEME}"* ]]; then
    printf 'light\n'
  else
    printf 'dark\n'
  fi
}

current="$(current_theme)"
target="${1:-toggle}"

case "$target" in
  toggle)
    if [[ "$current" == "light" ]]; then
      target="dark"
    else
      target="light"
    fi
    ;;
  status)
    printf '%s\n' "$current"
    exit 0
    ;;
  light|dark) ;;
  *)
    printf 'Usage: terminal-theme [toggle|light|dark|status]\n' >&2
    exit 2
    ;;
esac

tmp="$(mktemp "${THEME_FILE}.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

{
  printf '# Generated by terminal-theme; do not edit.\n'
  if [[ "$target" == "light" ]]; then
    printf 'theme = %s\n' "$LIGHT_THEME"
  fi
  printf 'window-theme = %s\n' "$target"
} >"$tmp"

mv "$tmp" "$THEME_FILE"
trap - EXIT

if ! osascript \
  -e 'tell application "System Events" to tell process "Ghostty"' \
  -e 'click menu item "Reload Configuration" of menu "Ghostty" of menu bar 1' \
  -e 'end tell' >/dev/null 2>&1; then
  printf 'Theme saved. Press Cmd+Shift+R in Ghostty to apply it.\n' >&2
fi

if [[ -n "${ZELLIJ:-}" ]]; then
  zellij action "set-${target}-theme" >/dev/null 2>&1 || true
fi

# onedark does not infer Ghostty's palette through Zellij reliably, so nudge every running nvim
# instance to read the same state file. New terminal buffers inherit the selected ANSI palette.
pkill -USR1 -x nvim 2>/dev/null || true

printf 'Terminal theme: %s\n' "$target"
